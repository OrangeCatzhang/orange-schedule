[
  {
    "id": "classic-001",
    "text": "学而时习之，不亦说乎？",
    "source": "《论语·学而》",
    "url": "https://zh.wikisource.org/wiki/論語/學而第一"
  },
  {
    "id": "classic-002",
    "text": "温故而知新，可以为师矣。",
    "source": "《论语·为政》",
    "url": "https://zh.wikisource.org/wiki/論語/為政第二"
  },
  {
    "id": "classic-003",
    "text": "三人行，必有我师焉。",
    "source": "《论语·述而》",
    "url": "https://zh.wikisource.org/wiki/論語/述而第七"
  },
  {
    "id": "classic-004",
    "text": "知之者不如好之者，好之者不如乐之者。",
    "source": "《论语·雍也》",
    "url": "https://zh.wikisource.org/wiki/論語/雍也第六"
  },
  {
    "id": "classic-005",
    "text": "锲而不舍，金石可镂。",
    "source": "《荀子·劝学》",
    "url": "https://zh.wikisource.org/wiki/荀子/勸學篇"
  },
  {
    "id": "classic-006",
    "text": "不积小流，无以成江海。",
    "source": "《荀子·劝学》",
    "url": "https://zh.wikisource.org/wiki/荀子/勸學篇"
  },
  {
    "id": "classic-007",
    "text": "博学之，审问之，慎思之，明辨之，笃行之。",
    "source": "《礼记·中庸》",
    "url": "https://zh.wikisource.org/wiki/禮記/中庸"
  },
  {
    "id": "classic-008",
    "text": "苟日新，日日新，又日新。",
    "source": "《礼记·大学》",
    "url": "https://zh.wikisource.org/wiki/禮記/大學"
  },
  {
    "id": "classic-009",
    "text": "千里之行，始于足下。",
    "source": "《老子·第六十四章》",
    "url": "https://zh.wikisource.org/wiki/道德經_(王弼本)#六十四章"
  },
  {
    "id": "classic-010",
    "text": "为之于未有，治之于未乱。",
    "source": "《老子·第六十四章》",
    "url": "https://zh.wikisource.org/wiki/道德經_(王弼本)#六十四章"
  },
  {
    "id": "classic-011",
    "text": "知人者智，自知者明。",
    "source": "《老子·第三十三章》",
    "url": "https://zh.wikisource.org/wiki/道德經_(王弼本)#三十三章"
  },
  {
    "id": "classic-012",
    "text": "天行健，君子以自强不息。",
    "source": "《周易·乾·象》",
    "url": "https://zh.wikisource.org/wiki/周易/乾"
  },
  {
    "id": "classic-013",
    "text": "地势坤，君子以厚德载物。",
    "source": "《周易·坤·象》",
    "url": "https://zh.wikisource.org/wiki/周易/坤"
  },
  {
    "id": "classic-014",
    "text": "行到水穷处，坐看云起时。",
    "source": "《终南别业》",
    "url": "https://zh.wikisource.org/wiki/終南別業"
  },
  {
    "id": "classic-015",
    "text": "山重水复疑无路，柳暗花明又一村。",
    "source": "《游山西村》",
    "url": "https://zh.wikisource.org/wiki/遊山西村"
  },
  {
    "id": "classic-016",
    "text": "长风破浪会有时，直挂云帆济沧海。",
    "source": "《行路难·其一》",
    "url": "https://zh.wikisource.org/wiki/行路難_(李白)#一"
  },
  {
    "id": "classic-017",
    "text": "好雨知时节，当春乃发生。",
    "source": "《春夜喜雨》",
    "url": "https://zh.wikisource.org/wiki/春夜喜雨"
  },
  {
    "id": "classic-018",
    "text": "会当凌绝顶，一览众山小。",
    "source": "《望岳》",
    "url": "https://zh.wikisource.org/wiki/望嶽_(岱宗夫如何)"
  },
  {
    "id": "classic-019",
    "text": "欲穷千里目，更上一层楼。",
    "source": "《登鹳雀楼》",
    "url": "https://zh.wikisource.org/wiki/登鸛雀樓_(王之渙)"
  },
  {
    "id": "classic-020",
    "text": "莫听穿林打叶声，何妨吟啸且徐行。",
    "source": "《定风波·莫听穿林打叶声》",
    "url": "https://zh.wikisource.org/wiki/定風波_(莫聽穿林打葉聲)"
  }
]
