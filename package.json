{
  "name": "weeklight",
  "version": "1.2.0",
  "description": "橙子日程 · Windows 桌面日历与待办清单",
  "main": "src/main.cjs",
  "author": "OrangeCatzhang",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "node tests/desktop.cjs",
    "build": "electron-builder --win dir",
    "dist": "electron-builder --win nsis",
    "test:widget": "node tests/widget-desktop.cjs",
    "test:packaged": "node tests/package-smoke.cjs",
    "build:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "prestart": "npm run build:native",
    "prebuild": "npm run build:native",
    "predist": "npm run build:native",
    "test:layer": "node tests/widget-layer.cjs",
    "pretest:widget": "npm run build:native",
    "pretest:layer": "npm run build:native",
    "test:startup": "node tests/startup-desktop.cjs",
    "test:reminder": "node tests/reminder-desktop.cjs",
    "test:list": "node tests/list-desktop.cjs",
    "test:daily": "node tests/daily-desktop.cjs",
    "test:weekdays": "node tests/weekday-desktop.cjs",
    "test:series": "node tests/task-series-desktop.cjs",
    "test:updates": "node tests/update-desktop.cjs",
    "test:branding": "node tests/window-branding-desktop.cjs",
    "test:language": "node tests/language-desktop.cjs && node tests/language-backend.cjs"
  },
  "build": {
    "appId": "local.weeklight.planner",
    "productName": "橙子日程",
    "directories": {
      "output": "outputs/weeklight-1.2.0"
    },
    "files": [
      "src/**/*",
      "!src/native/*.exe",
      "package.json",
      "LICENSE"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "installerLanguages": [
        "en_US",
        "zh_CN"
      ],
      "displayLanguageSelector": true,
      "include": "scripts/installer.nsh",
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "橙子日程",
      "artifactName": "OrangeSchedule-Setup-${version}.${ext}"
    },
    "electronDist": "node_modules/electron/dist",
    "extraResources": [
      {
        "from": "src/native/WeeklightLayer.exe",
        "to": "native/WeeklightLayer.exe"
      },
      {
        "from": "src/assets/icon.ico",
        "to": "assets/icon.ico"
      }
    ]
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "playwright": "^1.63.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OrangeCatzhang/orange-schedule.git"
  },
  "bugs": {
    "url": "https://github.com/OrangeCatzhang/orange-schedule/issues"
  },
  "homepage": "https://github.com/OrangeCatzhang/orange-schedule#readme"
}
